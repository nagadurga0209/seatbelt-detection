# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your secrets stay out of version control.

# --- Roboflow (dataset download) ---
# Free API key: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# --- Twilio (SMS alerts) ---
# From your Twilio console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000

# --- Alert defaults (optional) ---
SB_ALERT_TO=+910000000000
SB_VEHICLE=AP 39 XX 1234

# --- Model / training overrides (optional) ---
# SB_BASE_MODEL=yolov8s.pt
# SB_EPOCHS=100
# SB_IMG_SIZE=640
# SB_BATCH=16
# SB_CONF=0.35
# Class names in your dataset that count as a violation (comma-separated):
# SB_VIOLATION_CLASSES=no_seatbelt,no,0
